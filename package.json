{
  "name": "joshua-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "build": "npm run typecheck && vite build && tsx scripts/prerender.tsx",
    "preview": "vite preview --host 127.0.0.1",
    "check:site": "node scripts/check-site.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run build && npm run check:site"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/cli": "^0.1.24",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "playwright": "1.65.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "simple-icons": "^16.37.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
